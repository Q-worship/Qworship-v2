# Production stack for app.qworship.com — copy to .env on the deploy host (never commit .env)

# === Required (unchanged from previous deploy) ===
MONGODB_URI=
JWT_SECRET=
BREVO_API_KEY=
BREVO_SMTP_SERVER=smtp-relay.brevo.com
BREVO_LOGIN=
BREVO_SMTP_KEY=
BREVO_PORT=587
EMAIL_FROM=verify@qworship.com
EMAIL_FROM_NAME=Q-Worship
PUBLIC_SITE_URL=https://qworship.com

# === Required for Cloudflare R2 uploads and downloads ===
# Use the S3 API endpoint shown on the R2 API-token confirmation page.
# Default jurisdiction:
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# EU jurisdiction example:
# R2_ENDPOINT=https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com
R2_BUCKET_NAME=qworship
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional public/custom-domain base URL, without a trailing slash.
R2_PUBLIC_URL=

# === Marketing + gateway cutover ===
FRONTEND_URL=https://app.qworship.com
VITE_API_URL=/api
VITE_WS_URL=wss://app.qworship.com
CHAT_API_ORIGIN=https://new-website.vianneycm.workers.dev

# === Optional (same as before) ===
# OPENAI_API_KEY=
# SESSION_SECRET=
# ELEVENLABS_API_KEY=
# LT_API_KEY=
# LT_BASE_URL=
# SLACK_WEBHOOK_URL=
